# Скопируйте этот файл в .env.local и заполните реальными значениями.
# .env.local добавлен в .gitignore и никогда не должен попадать в git.

# --- Google OAuth (вход пользователей) ---
# Создаются в Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID (тип: Web application).
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx

# --- Google Таблица со справочником ---
# ID — часть URL таблицы между /d/ и /edit
GOOGLE_SHEET_ID=1-2AAZS4JuPzb28ydu7YtlF0kTJPZ0Sw7Z4oLZf_-oVM

# --- Сессия ---
# Любая длинная случайная строка (например: openssl rand -base64 32).
# Этим секретом шифруется сессионная cookie с токенами пользователя.
NEXTAUTH_SECRET=replace-with-long-random-string

# Базовый URL приложения. Для локальной разработки:
NEXTAUTH_URL=http://localhost:3000

# --- СДЭК (только сервер, в браузер не попадает) ---
# Учётная запись интеграции из личного кабинета СДЭК.
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# Необязательно: URL API. По умолчанию боевой https://api.cdek.ru/v2.
# Для тестового контура: https://api.edu.cdek.ru/v2 (с тестовыми кредами СДЭК)
# CDEK_API_URL=

# --- Dellin / Delovye Linii (server only) ---
DELLIN_APP_KEY=
DELLIN_PAT=
# Optional API URL. Default: https://api.dellin.ru
# DELLIN_API_URL=
